# ─────────────────────────────────────────
# Supabase / Prisma — Variables de connexion
# ─────────────────────────────────────────
# Récupérer ces valeurs sur : https://supabase.com/dashboard/project/[ton-projet]/settings/database

DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-eu-west-3.pooler.supabase.com:5432/postgres"

# ─────────────────────────────────────────
# Supabase JS Client
# ─────────────────────────────────────────
# Récupérer ces valeurs sur : https://supabase.com/dashboard/project/[ton-projet]/settings/api

NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon-key]"
